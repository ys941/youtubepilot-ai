# YouTubePilot AI — environment variables
# Copy to .env (Docker) or .env.local (local dev); set the same on your host for production.
# ✅ = required   – = optional
# No keys are bundled — every value below is supplied by YOU. Configure your brand
# (name, niche, handles) in the app under Settings → Brand after first login.

# ── Branding (white-label) ────────────────────────────────────────────────────
BRAND_NAME=                         # – default app/brand name fallback (e.g. "Tasty Bites AI")
NEXT_PUBLIC_APP_NAME=               # – public app name shown in the browser title/UI

# ── Core ──────────────────────────────────────────────────────────────────────
DATABASE_URL=                       # ✅ PostgreSQL connection string
APP_ACCESS_KEY=                     # ✅ access key gating the dashboard login
SESSION_SECRET=                     # ✅ HMAC secret for the auth session cookie (middleware)
NEXT_PUBLIC_APP_URL=                # – public app URL

# ── AI providers ──────────────────────────────────────────────────────────────
GROK_API_KEY=                       # ✅ Groq key (comments, content fallback)
GROK_API_URL=                       # – default https://api.groq.com/openai/v1
AI_MODEL_MAIN=                      # – main Groq model (llama-3.3-70b-versatile)
AI_MODEL_FAST=                      # – fast Groq fallback (llama-3.1-8b-instant)
GEMINI_API_KEY=                     # ✅ Google Gemini key (content, vision, music mood)
GEMINI_MODEL=                       # – optional Gemini model override

# ── Media hosting ─────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=              # ✅ media hosting (images + audio)
CLOUDINARY_UPLOAD_PRESET=           # ✅ unsigned upload preset
CLOUDINARY_API_KEY=                 # – for deleting media after publish
CLOUDINARY_API_SECRET=              # – for deleting media after publish

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=                     # ✅ daily report + alert emails
RESEND_FROM=                        # – from address for Resend
NOTIFICATION_EMAIL=                 # ✅ report recipient

# ── YouTube (Shorts auto-poster + comment replies) ─────────────────────────────
YOUTUBE_CLIENT_ID=                  # ✅ OAuth client ID
YOUTUBE_CLIENT_SECRET=              # ✅ OAuth client secret
YOUTUBE_REFRESH_TOKEN=              # ✅ channel refresh token (scopes: upload, readonly, force-ssl, yt-analytics)
YOUTUBE_CHANNEL_ID=                 # – channel ID (display only)

# ── Music for Shorts ──────────────────────────────────────────────────────────
JAMENDO_CLIENT_ID=                  # – free Jamendo API client id (vision-selected background music)

# ── Video encoding ────────────────────────────────────────────────────────────
FFMPEG_PATH=                        # – path to the ffmpeg binary (defaults to the bundled ffmpeg-static)
